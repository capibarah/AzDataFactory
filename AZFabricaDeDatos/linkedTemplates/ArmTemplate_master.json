{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AZFabricaDeDatos"
		},
		"AzureBlobStorageOutput_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorageOutput'"
		},
		"AzureSqlDatabaseInput_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaseInput'"
		},
		"AzureSqlDatabaseInput_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azdatafactory.database.windows.net"
		},
		"AzureSqlDatabaseInput_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQLDB_AZDF"
		},
		"AzureSqlDatabaseInput_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "cromero"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "AZFabricaDeDatos_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorageOutput_connectionString": {
						"value": "[parameters('AzureBlobStorageOutput_connectionString')]"
					},
					"AzureSqlDatabaseInput_password": {
						"value": "[parameters('AzureSqlDatabaseInput_password')]"
					},
					"AzureSqlDatabaseInput_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaseInput_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaseInput_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaseInput_properties_typeProperties_database')]"
					},
					"AzureSqlDatabaseInput_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabaseInput_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}